MYSQL_HOST=
MYSQL_PORT=
MYSQL_DB=
MYSQL_USER=
MYSQL_PASSWORD=

# AI. The only provider: the OpenAI SDK is pointed at api.deepseek.com
# (deepseek-chat) — see app/services/ai_service.py.
DEEPSEEK_API_KEY=

# AD / LDAP SSO gateway (PANJIT group). AD_API is the X-API-Key.
AD_URL=
AD_API=
# Gateway TLS cert lacks a Subject Key Identifier; leave false unless fixed.
AD_VERIFY_SSL=false


# 地端 LLM 閘道（OpenAI 相容）— CP 檔案版面辨識用，資料不出內網
LLM_BASE_URL=
LLM_API_KEY=
